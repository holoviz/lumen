{#- Blocks run from most to least stable so providers can cache the longest
    possible prompt prefix: static instructions, then data context, then
    per-request tool output, errors and the date. -#}
{%- block global %}
Do not excessively reason in responses; chain_of_thought fields for that, but should also be concise (1-2 sentences).
{%- endblock %}

{%- block instructions -%}
{%- endblock -%}

{%- block docs -%}
{%- endblock -%}

{%- block examples -%}
{%- endblock -%}

{%- block context -%}
{%- endblock %}

{%- block tools -%}
{%- if 'agent_tool_contexts' in memory and actor_name in memory["agent_tool_contexts"] %}
{#- Agent-specific tool contexts -#}
{% for key, value in memory["agent_tool_contexts"][actor_name].items() %}
`{{ key }}`: {{ value }}
{% endfor %}
{%- endif -%}
{%- endblock -%}

{%- block errors -%}
{%- if last_output is defined and last_output %}
Note, last output did not work as intended:
```
{{ last_output }}
```
{% endif %}
{%- if errors is defined and errors %}
Task expertly address errors so they do not occur again:
{% for error in errors %}
- {{ error }}
{% endfor %}
{%- endif %}
{%- endblock -%}

{% block footer -%}
{%- endblock -%}

{%- block datetime %}

Current date: {{ current_datetime.strftime('%b %d, %Y') }}
{%- endblock %}
